{
  "name": "puzzle-game-core",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @puzzle-game-core/web dev",
    "build": "bun run --filter @puzzle-game-core/web build",
    "test": "bun test",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run --filter @puzzle-game-core/web typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
